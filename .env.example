# Copy to .env and fill in. Server-side only — never expose these to the frontend or commit real values.
BIMPEAI_API_KEY=
BIMPE_API_URL=https://api.bimpe.ai
# Optional: if empty, the server finds the agent named "Vital AI" automatically.
BIMPE_AGENT_ID=
# Optional: not needed for agent conversations.
BIMPE_WORKFLOW_ID=
# Optional: pre-fills the DEMO patients' phone number in the UI (E.164, e.g. +2348012345678).
DEMO_PATIENT_PHONE=
PORT=3001
